# Copy this file to .env and fill in real values. .env is git-ignored.
#   cp .env.example .env

# PostgreSQL + pgvector running in Docker (set up in Step 3)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ragmotion

# LLM via OpenRouter: https://openrouter.ai/keys  (needed from Step 6)
OPENROUTER_API_KEY=
# Optional: override the default LLM (see src/ragmotion/config.py)
# LLM_MODEL=google/gemini-2.5-flash-lite

# Not needed: embeddings go through OpenRouter (verified in Step 7).
# Only set this if we ever call Voyage directly: https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Optional: direct Anthropic access, if we use Claude without OpenRouter
ANTHROPIC_API_KEY=

# LangSmith tracing (Step 14): https://smith.langchain.com  -> Settings -> API Keys
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=rag-motion
