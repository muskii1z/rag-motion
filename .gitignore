# Secrets: never commit real keys
.env
.env.*
!.env.example

# Python environment and build output (rebuilt from uv.lock)
.venv/
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS / editor noise
.DS_Store
.idea/
.vscode/

# Claude Code per-machine settings (the shared agent definitions in .claude/agents/ ARE committed)
.claude/settings.local.json

# Downloaded source documents (PDFs, HTML) and their extracted text. Rebuilt by the ingestion
# script from the source manifest; never committed (licenses and repo size).
data/raw/
